# MT5 Bridge —— 运行 MT5 终端的 Windows 主机（bridge 监听 8001；本机 Mac 通过局域网/SSH 隧道调用）
# 例：Windows 机器在局域网 192.168.3.47 → http://192.168.3.47:8001
#     隧道方式 ssh -N -L 8001:localhost:8001 user@host → http://localhost:8001
MT5_BRIDGE_URL=http://192.168.3.47:8001
MT5_BRIDGE_API_KEY=your_secret_bridge_key

# Database
DATABASE_URL=postgresql+asyncpg://user_sijiXB:password_WK2tfi@100.72.200.33:15432/mt5
DATABASE_URL_SYNC=postgresql+psycopg2://user_sijiXB:password_WK2tfi@100.72.200.33:15432/mt5

# Redis
REDIS_URL=redis://100.72.200.33:16379/2

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_CODE_OAUTH_TOKEN=

# LLM Provider (multi-model) — 默认 claude 走 Agent SDK；装其他模型设置:
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://100.78.102.105:8317/v1   # 或 https://api.openai.com/v1 / Ollama http://localhost:11434/v1
LLM_API_KEY=sk-9a08f42abb88087cb6002e47787a3a8f05c69a71afdbb784      # Ollama/vLLM 本地可留空
LLM_MODEL=deepseek-v4-flash                    # 全局默认模型 (可选；空则用 per-agent 默认)
MODEL_ORCHESTRATOR=deepseek-v4-flash                  # 决策模型 (可选覆盖)
MODEL_SPECIALIST=deepseek-v4-flash                # 分析模型 (可选覆盖)
LLM_ALLOW_LIVE=false                        # true 才放开 live 交易 (默认 shadow/paper 拦截)
LLM_MAX_ORDERS_PER_LOOP=1                   # 每 agent 循环最多执行几次交易工具 (1-3)
CUSTOM_PRICE_PER_MILLION={"deepseek-v4-flash":{"input":1,"output":1}}

# LLM 生成内容的自然语言输出语言（zh/en）。后台定时任务（AI 决策/情绪/优化）用此默认值；
# 前端手动触发的分析跟随请求头 Accept-Language，不受此项影响。默认 zh
LLM_RESPONSE_LANG=zh

# Bot Config
# 品种配置说明：运行时以 DB 表 symbol_configs 为准（/symbols 页面管理，支持热重载）。
# SYMBOLS 仅作为 DB 不可用时的兜底逗号分隔列表；SYMBOL 是遗留单品种默认值，
# 只被少数 AI 辅助函数使用，运行时交易不要依赖它。
SYMBOL=GOLD
# SYMBOLS=GOLD,OILCash,BTCUSD,USDJPY
TIMEFRAME=M15
# 启动时对已启用品种做券商存在性校验：warn=只告警不阻断（默认）；strict=券商
# 报告品种不存在/不可交易时引擎置为 PAUSED（持仓对账与手动平仓仍可用）。
SYMBOL_STARTUP_VALIDATION=warn
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
# 日内 equity（余额+浮动盈亏）回撤闸门：≥ 阈值停新开仓；0=禁用
MAX_EQUITY_DRAWDOWN=0.03
MAX_CONCURRENT_TRADES=3
MAX_LOT=1.0
USE_AI_FILTER=true
AI_CONFIDENCE_THRESHOLD=0.7

# Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Optional HTTP proxy for Telegram API (leave empty for direct connection)
TELEGRAM_PROXY_URL=

# API
SECRET_KEY=174cbf7b69d02d4f48d1c47560e2380c1439d569cb9060fa2815e233cbc04b43
