# MT5 Bridge (Windows VPS)
MT5_BRIDGE_URL=http://YOUR_VPS_IP:8080
MT5_BRIDGE_API_KEY=your_secret_bridge_key

# Database
DATABASE_URL=postgresql+asyncpg://goldbot:your_password@localhost:5432/goldbot
DATABASE_URL_SYNC=postgresql://goldbot:your_password@localhost:5432/goldbot

# Redis
REDIS_URL=redis://localhost:6379/0

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_CODE_OAUTH_TOKEN=

# LLM Provider (multi-model) — 默认 claude 走 Agent SDK；装其他模型设置:
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com/v1   # 或 https://api.openai.com/v1 / Ollama http://localhost:11434/v1
# LLM_API_KEY=your_openai_compatible_key      # Ollama/vLLM 本地可留空
# LLM_MODEL=deepseek-chat                     # 全局默认模型 (可选；空则用 per-agent 默认)
# MODEL_ORCHESTRATOR=gpt-4o                   # 决策模型 (可选覆盖)
# MODEL_SPECIALIST=gpt-4o-mini                # 分析模型 (可选覆盖)
# LLM_ALLOW_LIVE=false                        # true 才放开 live 交易 (默认 shadow/paper 拦截)
# LLM_MAX_ORDERS_PER_LOOP=1                   # 每 agent 循环最多执行几次交易工具 (1-3)
# CUSTOM_PRICE_PER_MILLION={"gpt-4o":{"input":2.5,"output":10}}

# Bot Config
SYMBOL=GOLD
TIMEFRAME=M15
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_CONCURRENT_TRADES=3
MAX_LOT=1.0
USE_AI_FILTER=true
AI_CONFIDENCE_THRESHOLD=0.7

# Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# API
SECRET_KEY=generate_random_32_char_string
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
